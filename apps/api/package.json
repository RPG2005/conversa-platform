{
  "name": "@chat-yes-no/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:verify": "tsx src/db/verify-migration.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.7",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.12.0",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.36.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
