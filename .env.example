# Copy this file to .env before starting the environment.
POSTGRES_DB=chat_yes_no
POSTGRES_USER=chat_user
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

REDIS_PASSWORD=replace-with-a-local-password
REDIS_PORT=6379

API_SECRET=replace-with-a-long-random-local-secret
API_PORT=3000

S3_ACCESS_KEY=local-access-key
S3_SECRET_KEY=replace-with-a-local-password
S3_BUCKET=chat-media
S3_PORT=8333

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
